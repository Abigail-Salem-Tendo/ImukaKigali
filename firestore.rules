rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // helpers 
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasRole(role) {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.role == role;
    }

    // True when only the listed fields differ between the old and new document.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // After the write the job is still accepted, or it is completed with
    // both sides confirmed.
    function deliveryStateIsValid() {
      return request.resource.data.status == 'accepted' ||
        (request.resource.data.status == 'completed' &&
         request.resource.data.clientConfirmed == true &&
         request.resource.data.driverConfirmed == true);
    }

    // True when the signed-in user is the client or the driver of this request.
    function isInvolved(requestId) {
      let req = get(/databases/$(database)/documents/requests/$(requestId)).data;
      return signedIn() &&
        (req.clientId == request.auth.uid || req.driverId == request.auth.uid);
    }

    // users 
    // A signed-in user can read one profile (for driver contact) but cannot list.
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if isOwner(uid) &&
        request.resource.data.role in ['client', 'driver'];
      // The role never changes, because other rules depend on it.
      allow update: if isOwner(uid) &&
        request.resource.data.role == resource.data.role;
      allow list, delete: if false;
    }

    // vehicles 
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create: if hasRole('driver') &&
        request.resource.data.driverId == request.auth.uid;
      allow update: if isOwner(resource.data.driverId) &&
        request.resource.data.driverId == resource.data.driverId;
      allow delete: if isOwner(resource.data.driverId);
    }

    // requests 
    match /requests/{requestId} {
      // The client sees their own requests. A driver sees open jobs and
      // the jobs assigned to them.
      allow read: if isOwner(resource.data.clientId) ||
        (hasRole('driver') &&
          (resource.data.status == 'open' ||
           resource.data.driverId == request.auth.uid));

      // A client creates an open request for themselves, with no driver yet.
      allow create: if hasRole('client') &&
        request.resource.data.keys().hasOnly([
          'clientId', 'driverId', 'pickupLocation', 'dropoffLocation',
          'itemDescription', 'vehicleType', 'estimatedMinutes',
          'proposedAmount', 'status', 'clientConfirmed', 'driverConfirmed',
          'createdAt'
        ]) &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.driverId == '' &&
        request.resource.data.status == 'open' &&
        request.resource.data.clientConfirmed == false &&
        request.resource.data.driverConfirmed == false &&
        request.resource.data.vehicleType in ['car', 'tricycle', 'hilux', 'pickup', 'van', 'truck'] &&
        request.resource.data.proposedAmount is number &&
        request.resource.data.proposedAmount > 0 &&
        request.resource.data.estimatedMinutes is int &&
        request.resource.data.createdAt == request.time;

      allow update: if
        // Client cancels while the request is still open.
        (isOwner(resource.data.clientId) &&
          resource.data.status == 'open' &&
          request.resource.data.status == 'cancelled' &&
          onlyChanges(['status'])) ||
        // Client confirms delivery (and may complete once both confirmed).
        (isOwner(resource.data.clientId) &&
          resource.data.status == 'accepted' &&
          onlyChanges(['clientConfirmed', 'status']) &&
          request.resource.data.clientConfirmed == true &&
          deliveryStateIsValid()) ||
        // A driver accepts an open job for themselves.
        (hasRole('driver') &&
          resource.data.status == 'open' &&
          resource.data.driverId == '' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.driverId == request.auth.uid &&
          onlyChanges(['status', 'driverId'])) ||
        // The assigned driver confirms delivery (and may complete once both confirmed).
        (isOwner(resource.data.driverId) &&
          resource.data.status == 'accepted' &&
          onlyChanges(['driverConfirmed', 'status']) &&
          request.resource.data.driverConfirmed == true &&
          deliveryStateIsValid());

      allow delete: if false;
    }

    // payments
   // The document id is the request id, so each request has one payment.
    match /payments/{paymentId} {
      allow read: if isInvolved(paymentId);
      allow create: if paymentId == request.resource.data.requestId &&
        isInvolved(paymentId) &&
        request.resource.data.status in ['pending', 'paid'];
      allow update: if isInvolved(paymentId) &&
        request.resource.data.requestId == resource.data.requestId;
      allow delete: if false;
    }

    // ratings
    // The document id is the request id, so each request has one rating.
    match /ratings/{ratingId} {
      allow read: if isInvolved(ratingId);

      // The client rates their own completed request with 1 to 5 stars.
      allow create: if ratingId == request.resource.data.requestId &&
        isOwner(request.resource.data.clientId) &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5 &&
        get(/databases/$(database)/documents/requests/$(ratingId)).data.clientId == request.auth.uid &&
        get(/databases/$(database)/documents/requests/$(ratingId)).data.driverId == request.resource.data.driverId &&
        get(/databases/$(database)/documents/requests/$(ratingId)).data.status == 'completed';

      // The client can change only the stars and comment, or remove the rating.
      allow update: if isOwner(resource.data.clientId) &&
        onlyChanges(['stars', 'comment']) &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5;
      allow delete: if isOwner(resource.data.clientId);
    }
  }
}